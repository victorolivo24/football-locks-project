# Database
POSTGRES_URL="postgresql://username:password@host/database?sslmode=require"
# DATABASE_URL also works for local Drizzle commands if your provider uses that name.

# Admin (optional - for manual game results)
ADMIN_PASSCODE="admin123"

# Cron Jobs (optional - for auto-updating scores)
CRON_SECRET="cron123"

# Time Zone
TZ="America/New_York"
